\"green\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">g</field></block></value><value name=\"blue\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">b</field></block></value><next><block type=\"smartfeldAktoren_Chain_setColorJustOne\"><value name=\"chain\"><block type=\"variables_get\"><field name=\"VAR\" id=\"v[gdCq^#-T{|!;*%2QC+\">Kette</field></block></value><value name=\"numberOfRGB\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value><value name=\"red\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">r</field></block></value><value name=\"green\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">g</field></block></value><value name=\"blue\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">b</field></block></value></block></next></block></statement></block><block type=\"function_definition\" x=\"424\" y=\"2093\"><mutation name=\"einzelAugen\" functionid=\"(~Rm7Y)y7n!V:M@,k-kK\"><arg name=\"r1\" id=\"3umh648hqw7lzy54okmex\" type=\"number\"></arg><arg name=\"g1\" id=\"r98b1mgs176wn9kh3v92\" type=\"number\"></arg><arg name=\"b1\" id=\"ci4hmmo0jj8n2ask3ne8\" type=\"number\"></arg><arg name=\"r2\" id=\"nuxriqip92crgvtcxzb3f\" type=\"number\"></arg><arg name=\"g2\" id=\"w0at0arcnoknm0cswtpxk\" type=\"number\"></arg><arg name=\"b2\" id=\"strloq6dozwdws7ay8xh\" type=\"number\"></arg></mutation><field name=\"function_name\">einzelAugen</field><comment pinned=\"false\" h=\"80\" w=\"160\">Unterschiedliche Augenfarben</comment><value name=\"3umh648hqw7lzy54okmex\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">r1</field></block></value><value name=\"r98b1mgs176wn9kh3v92\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">g1</field></block></value><value name=\"ci4hmmo0jj8n2ask3ne8\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">b1</field></block></value><value name=\"nuxriqip92crgvtcxzb3f\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">r2</field></block></value><value name=\"w0at0arcnoknm0cswtpxk\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">g2</field></block></value><value name=\"strloq6dozwdws7ay8xh\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">b2</field></block></value><statement name=\"STACK\"><block type=\"smartfeldAktoren_Chain_setColorJustOne\"><value name=\"chain\"><block type=\"variables_get\"><field name=\"VAR\" id=\"v[gdCq^#-T{|!;*%2QC+\">Kette</field></block></value><value name=\"numberOfRGB\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"red\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">r1</field></block></value><value name=\"green\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">g1</field></block></value><value name=\"blue\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">b1</field></block></value><next><block type=\"smartfeldAktoren_Chain_setColorJustOne\"><value name=\"chain\"><block type=\"variables_get\"><field name=\"VAR\" id=\"v[gdCq^#-T{|!;*%2QC+\">Kette</field></block></value><value name=\"numberOfRGB\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value><value name=\"red\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">r2</field></block></value><value name=\"green\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">g2</field></block></value><value name=\"blue\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">b2</field></block></value></block></next></block></statement></block></xml>","main.ts":"\nlet Kette = smartfeldAktoren.createChain(DigitalPin.P0, DigitalPin.P14, 2)\n\n// Standard: Violett/Türkis und Geschwindigkeit 3\nlet palette = 2\nlet tempo = 3\n\nlet r1 = 180\nlet g1 = 0\nlet b1 = 255\nlet r2 = 0\nlet g2 = 255\nlet b2 = 200\n\nlet letzteAenderung = 0\nlet speichernNoetig = false\n\n// Gespeicherte Einstellungen laden\nlet gespeicherteFarbe = flashstorage.get(\"farbe\")\nlet gespeichertesTempo = flashstorage.get(\"tempo\")\n\nif (gespeicherteFarbe != \"\") {\n    let wert = parseInt(gespeicherteFarbe)\n    if (wert >= 0 && wert < 10) {\n        palette = wert\n    }\n}\n\nif (gespeichertesTempo != \"\") {\n    let wert = parseInt(gespeichertesTempo)\n    if (wert >= 1 && wert <= 5) {\n        tempo = wert\n    }\n}\n\n// Zehn Farbkombinationen\nfunction farbenWaehlen() {\n    if (palette == 0) {\n        r1 = 0; g1 = 255; b1 = 0\n        r2 = 0; g2 = 0; b2 = 255\n    } else if (palette == 1) {\n        r1 = 255; g1 = 0; b1 = 0\n        r2 = 255; g2 = 180; b2 = 0\n    } else if (palette == 2) {\n        // Violett / Türkis\n        r1 = 180; g1 = 0; b1 = 255\n        r2 = 0; g2 = 255; b2 = 200\n    } else if (palette == 3) {\n        // Pink / Giftgrün\n        r1 = 255; g1 = 0; b1 = 170\n        r2 = 0; g2 = 255; b2 = 136\n    } else if (palette == 4) {\n        // Ultraviolett / Eisblau\n        r1 = 117; g1 = 0; b1 = 255\n        r2 = 0; g2 = 170; b2 = 255\n    } else if (palette == 5) {\n        // Höllenrot / Violett\n        r1 = 255; g1 = 51; b1 = 0\n        r2 = 170; g2 = 0; b2 = 255\n    } else if (palette == 6) {\n        // Giftgrün / Pink\n        r1 = 0; g1 = 255; b1 = 68\n        r2 = 255; g2 = 0; b2 = 204\n    } else if (palette == 7) {\n        // Orange / Cyan\n        r1 = 255; g1 = 136; b1 = 0\n        r2 = 0; g2 = 221; b2 = 255\n    } else if (palette == 8) {\n        // Magenta / Gelb\n        r1 = 238; g1 = 0; b1 = 255\n        r2 = 255; g2 = 255; b2 = 0\n    } else {\n        // Blau / Hotpink\n        r1 = 68; g1 = 0; b1 = 255\n        r2 = 255; g2 = 0; b2 = 136\n    }\n}\n\n// Beide Augen synchron dimmen\nfunction augenFade(h: number) {\n    Kette.setColorJustOne(\n        0,\n        Math.idiv(r1 * h, 255),\n        Math.idiv(g1 * h, 255),\n        Math.idiv(b1 * h, 255)\n    )\n    Kette.setColorJustOne(\n        1,\n        Math.idiv(r2 * h, 255),\n        Math.idiv(g2 * h, 255),\n        Math.idiv(b2 * h, 255)\n    )\n}\n\n// Zeit zwischen den Helligkeitsschritten\nfunction fadePause(): number {\n    if (tempo == 1) return 35\n    if (tempo == 2) return 25\n    if (tempo == 3) return 16\n    if (tempo == 4) return 10\n    return 5\n}\n\n// Änderung zum späteren Speichern vormerken\nfunction aenderungMerken() {\n    letzteAenderung = input.runningTime()\n    speichernNoetig = true\n}\n\n// Taste A: nächste Farbe\ninput.onButtonPressed(Button.A, function () {\n    palette = (palette + 1) % 10\n    farbenWaehlen()\n    aenderungMerken()\n    basic.showNumber(palette + 1)\n})\n\n// Taste B: vorherige Farbe\ninput.onButtonPressed(Button.B, function () {\n    palette = (palette + 9) % 10\n    farbenWaehlen()\n    aenderungMerken()\n    basic.showNumber(palette + 1)\n})\n\n// Touch-Logo: Geschwindigkeit ändern\ninput.onLogoEvent(TouchButtonEvent.Pressed, function () {\n    tempo = (tempo % 5) + 1\n    aenderungMerken()\n    basic.showNumber(tempo)\n})\n\n// Einstellungen nach 3 Sekunden speichern\nbasic.forever(function () {\n    if (speichernNoetig &&\n        input.runningTime() - letzteAenderung >= 3000) {\n\n        flashstorage.put(\"farbe\", \"\" + palette)\n        flashstorage.put(\"tempo\", \"\" + tempo)\n        speichernNoetig = false\n    }\n    basic.pause(200)\n})\n\n// Farben beim Start laden\nfarbenWaehlen()\n\n// Geisterblick: synchrones Fade-in und Fade-out\nbasic.forever(function () {\n\n    for (let h = 0; h <= 255; h += 10) {\n        augenFade(h)\n        basic.pause(fadePause())\n    }\n\n    for (let h = 255; h >= 0; h -= 10) {\n        augenFade(h)\n        basic.pause(fadePause())\n    }\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"Augen\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-SensorikSmartfeld\": \"github:Smartfeld/pxt-sensorikAktorikSmartfeld#c3248f8ae41a66ebe67a30c3997b376872f703ca\",\n        \"microbit-pxt-flashstorage\": \"github:bsiever/microbit-pxt-flashstorage#v0.1.4\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1792850906595}