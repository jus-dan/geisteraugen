ts","patch":[{"start1":0,"length1":210,"diffs":[[1,"\nlet Kette = smartfeldAktoren.createChain(DigitalPin.P0, DigitalPin.P14, 2)\nlet modus = 3\nlet palette = 0\n\nlet r1 = 0\nlet g1 = 255\nlet b1 = 0\nlet r2 = 0\nlet g2 = 0\nlet b2 = 255\n\nfunction augen(\n    ar: number, ag: number, ab: number,\n    br: number, bg: number, bb: number\n) {\n    Kette.setColorJustOne(0, ar, ag, ab)\n    Kette.setColorJustOne(1, br, bg, bb)\n"]]},{"start1":361,"length1":34,"diffs":[[1,"\nfunction augenAus() {\n    augen(0, 0, 0, 0, 0, 0)\n}\n\nfunction farbenWaehlen() {\n    if (palette == 0) {\n        // Grün und Blau\n        r1 = 0\n        g1 = 255\n        b1 = 0\n        r2 = 0\n        g2 = 0\n        b2 = 255\n    } else if (palette == 1) {\n        // Rot und Gelb\n        r1 = 255\n        g1 = 0\n        b1 = 0\n        r2 = 255\n        g2 = 180\n        b2 = 0\n    } else if (palette == 2) {\n        // Violett und Türkis\n        r1 = 180\n        g1 = 0\n        b1 = 255\n        r2 = 0\n        g2 = 255\n        b2 = 200\n    } else {\n        // Orange und Pink\n        r1 = 255\n        g1 = 60\n        b1 = 0\n        r2 = 255\n        g2 = 0\n        b2 = 150\n    }\n}\n\n// Taste A: nächster Modus\n"]]},{"start1":1114,"length1":28,"diffs":[[1,"    modus = (modus + 1) % 7\n"]]},{"start1":1173,"length1":36,"diffs":[[1,"\n// Taste B: vorheriger Modus\n"]]},{"start1":1249,"length1":28,"diffs":[[1,"    modus = (modus + 6) % 7\n"]]},{"start1":1308,"length1":395,"diffs":[[1,"\n// Logo: Farbpalette wechseln\ninput.onLogoEvent(TouchButtonEvent.Pressed, function () {\n    palette = (palette + 1) % 4\n    farbenWaehlen()\n\n    // Farben sofort anzeigen\n    augen(r1, g1, b1, r2, g2, b2)\n    basic.showNumber(palette + 1)\n})\n\nfarbenWaehlen()\n\n"]]},{"start1":1597,"length1":0,"diffs":[[1,"\n"]]},{"start1":1620,"length1":207,"diffs":[[1,"        // DÄMON\n        augen(\n            randint(30, 255), 0, 0,\n            randint(30, 255), 0, 0\n        )\n        basic.pause(randint(50, 200))\n\n"]]},{"start1":1806,"length1":27,"diffs":[[1,"            augenAus()\n"]]},{"start1":1868,"length1":0,"diffs":[[1,"\n"]]},{"start1":1898,"length1":44,"diffs":[[1,"        // GEISTERBLICK mit Farbpalette\n        for (let i = 0; i <= 255; i += 10) {\n"]]},{"start1":2017,"length1":41,"diffs":[[1,"            augen(\n                Math.idiv(r1 * i, 255),\n                Math.idiv(g1 * i, 255),\n                Math.idiv(b1 * i, 255),\n                Math.idiv(r2 * i, 255),\n                Math.idiv(g2 * i, 255),\n                Math.idiv(b2 * i, 255)\n            )\n"]]},{"start1":2327,"length1":36,"diffs":[[1,"        for (let i = 255; i >= 0; i -= 10) {\n"]]},{"start1":2406,"length1":69,"diffs":[[1,"            augen(\n                Math.idiv(r1 * i, 255),\n                Math.idiv(g1 * i, 255),\n                Math.idiv(b1 * i, 255),\n                Math.idiv(r2 * i, 255),\n                Math.idiv(g2 * i, 255),\n                Math.idiv(b2 * i, 255)\n            )\n            basic.pause(30)\n"]]},{"start1":2716,"length1":0,"diffs":[[1,"\n"]]},{"start1":2746,"length1":426,"diffs":[[1,"        // HORROR-BLITZ\n        augenAus()\n        basic.pause(randint(150, 700))\n\n        for (let j = 0; j < 8; j++) {\n            if (modus != 2) break\n            augen(255, 0, 0, randint(30, 255), 0, 0)\n            basic.pause(40)\n            augenAus()\n            basic.pause(45)\n"]]},{"start1":3043,"length1":0,"diffs":[[1,"\n    } else if (modus == 3) {\n        // BESESSEN: Farbpalette und Flackern\n        let h1 = randint(80, 255)\n        let h2 = randint(80, 255)\n\n        augen(\n            Math.idiv(r1 * h1, 255),\n            Math.idiv(g1 * h1, 255),\n            Math.idiv(b1 * h1, 255),\n            Math.idiv(r2 * h2, 255),\n            Math.idiv(g2 * h2, 255),\n            Math.idiv(b2 * h2, 255)\n        )\n        basic.pause(randint(50, 180))\n\n        if (randint(0, 10) == 0) {\n            augenAus()\n            basic.pause(100)\n        }\n\n    } else if (modus == 4) {\n        // HYPNOSE\n        augen(r1, g1, b1, r2, g2, b2)\n        basic.pause(250)\n\n        if (modus == 4) {\n            augen(r2, g2, b2, r1, g1, b1)\n            basic.pause(250)\n        }\n\n    } else if (modus == 5) {\n        // FARBWAHNSINN\n        augen(\n            randint(0, 255),\n            randint(0, 255),\n            randint(0, 255),\n            randint(0, 255),\n            randint(0, 255),\n            randint(0, 255)\n        )\n        basic.pause(randint(60, 200))\n\n"]]},{"start1":4094,"length1":380,"diffs":[[1,"        // TELEFON-MONSTER\n        let h1 = randint(180, 255)\n        let h2 = randint(180, 255)\n\n        augen(\n            Math.idiv(r1 * h1, 255),\n            Math.idiv(g1 * h1, 255),\n            Math.idiv(b1 * h1, 255),\n            Math.idiv(r2 * h2, 255),\n            Math.idiv(g2 * h2, 255),\n            Math.idiv(b2 * h2, 255)\n        )\n        basic.pause(randint(150, 400))\n\n        if (randint(0, 15) == 0) {\n            augen(0, 0, 0, r2, g2, b2)\n            basic.pause(100)\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":138,"length1":149,"diffs":[[1,"        \"pxt-SensorikSmartfeld\": \"github:Smartfeld/pxt-sensorikAktorikSmartfeld#c3248f8ae41a66ebe67a30c3997b376872f703ca\"\n"]]}]}]},{"timestamp":1792850491010,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":30050,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"KF@#lBxRl!.0^nRDs{(0\">modus</variable><variable id=\"v[gdCq^#-T{|!;*%2QC+\">Kette</variable><variable id=\"%;{m2Ah11cS)vq%wqA8(\">hell</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"let modus = 0\" numlines=\"1\" declaredvars=\"modus\"></mutation><next><block type=\"vari