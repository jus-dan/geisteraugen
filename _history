c.pause(randint(40, 220))\n        // Zufälliges Blinzeln\n"]]},{"start1":1178,"length1":23,"diffs":[[1,"            augen(0, 0, 0)\n"]]},{"start1":1244,"length1":1,"diffs":[[1,""]]},{"start1":1273,"length1":85,"diffs":[[1,"        for (let i = 0; i <= 240; i += 8) {\n"]]},{"start1":1351,"length1":272,"diffs":[[1,"            augen(i, 0, Math.idiv(i, 3))\n"]]},{"start1":1430,"length1":45,"diffs":[[1,"for (let j = 240; j >= 0; j -= 8) {\n"]]},{"start1":1500,"length1":300,"diffs":[[1,"            augen(j, 0, Math.idiv(j, 3))\n            basic.pause(35)\n"]]},{"start1":1579,"length1":1,"diffs":[[1,""]]},{"start1":1608,"length1":287,"diffs":[[1,"        // HORROR: wilde Schreckblitze\n        augen(0, 0, 0)\n        basic.pause(randint(200, 1200))\n        for (let index = 0; index < randint(3, 12); index++) {\n            if (modus != 2) {\n                break;\n            }\n            einzelAugen(255, randint(0, 35), randint(0, 35), randint(0, 255), 0, 0)\n            basic.pause(randint(20, 75))\n            augen(0, 0, 0)\n            basic.pause(randint(20, 100))\n"]]},{"start1":2044,"length1":1038,"diffs":[[1,""]]},{"start1":2057,"length1":487,"diffs":[[1,"        // BESESSEN: irre, wechselnde Augen\n        einzelAugen(255, 0, 0, 0, 255, 0)\n        basic.pause(160)\n        einzelAugen(0, 255, 0, 255, 0, 100)\n        basic.pause(160)\n        einzelAugen(150, 0, 255, 255, 0, 0)\n        basic.pause(160)\n        // Kurzer Blackout\n        if (randint(0, 5) == 0) {\n            augen(0, 0, 0)\n            basic.pause(randint(100, 500))\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":351,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]}]},{"timestamp":1792849963019,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":24486,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"KF@#lBxRl!.0^nRDs{(0\">modus</variable><vari